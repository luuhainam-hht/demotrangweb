        <mxCell id="note0" value="Ba tiến trình nền không do người dùng kích hoạt: UC-50 chạy theo Call Timeout (mặc định 45 giây),&lt;br&gt;UC-51 chạy đúng giờ EOD_PURGE_HOUR theo GIỜ VIỆT NAM, UC-52 quét mỗi phút.&lt;br&gt;UC-47 bắt buộc grounding từ CSDL để Trợ lý AI không tự bịa thủ tục." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="1060" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="CHÚ GIẢI KÝ HIỆU&lt;br&gt;Đường liền nét, không mũi tên  →  Association (tác nhân dùng chức năng)&lt;br&gt;Nét đứt, mũi tên hở, nhãn «include»  →  chức năng bắt buộc được gọi lại&lt;br&gt;Nét đứt, mũi tên hở, nhãn «extend»  →  chức năng mở rộng, có điều kiện&lt;br&gt;Nét liền, mũi tên tam giác rỗng  →  Generalization (kế thừa vai trò)" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1060" width="700" height="110" as="geometry" />
        </mxCell>

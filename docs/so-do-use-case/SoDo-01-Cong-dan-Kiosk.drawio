        <mxCell id="note0" value="Luồng chính: Trang chủ → tìm thủ tục (UC-03) → đối chiếu checklist (UC-04)&lt;br&gt;→ lấy số (UC-05) → quét QR theo dõi trên điện thoại (UC-11).&lt;br&gt;UC-12 chạy ngay đầu UC-05: ngoài giờ thì trả về CLOSED, không cấp số." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="1240" width="700" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="CHÚ GIẢI KÝ HIỆU&lt;br&gt;Đường liền nét, không mũi tên  →  Association (tác nhân dùng chức năng)&lt;br&gt;Nét đứt, mũi tên hở, nhãn «include»  →  chức năng bắt buộc được gọi lại&lt;br&gt;Nét đứt, mũi tên hở, nhãn «extend»  →  chức năng mở rộng, có điều kiện&lt;br&gt;Nét liền, mũi tên tam giác rỗng  →  Generalization (kế thừa vai trò)" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1240" width="700" height="110" as="geometry" />
        </mxCell>
      </root>

        <mxCell id="note0" value="UC-33 chỉ san tải giữa các quầy CÙNG LĨNH VỰC để tránh công dân phải di chuyển sai quầy.&lt;br&gt;UC-34, UC-35, UC-36 bắt buộc chọn lý do từ danh mục cứng (bảng priority_reasons)&lt;br&gt;và luôn ghi Audit Log — không cho phép can thiệp hàng đợi mà không truy vết được." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="1340" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="CHÚ GIẢI KÝ HIỆU&lt;br&gt;Đường liền nét, không mũi tên  →  Association (tác nhân dùng chức năng)&lt;br&gt;Nét đứt, mũi tên hở, nhãn «include»  →  chức năng bắt buộc được gọi lại&lt;br&gt;Nét đứt, mũi tên hở, nhãn «extend»  →  chức năng mở rộng, có điều kiện&lt;br&gt;Nét liền, mũi tên tam giác rỗng  →  Generalization (kế thừa vai trò)" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1340" width="700" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="note0" value="UC-37 là Dynamic Policy Engine: đổi tham số nghiệp vụ (Call Timeout, Max Retry, giờ mở cửa...)&lt;br&gt;ngay trên giao diện, có hiệu lực tức thì, không cần sửa mã nguồn hay triển khai lại.&lt;br&gt;UC-45 và UC-46 thu hồi phiên ngay lập tức — khóa tài khoản có hiệu lực tức thì." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="320" y="1160" width="820" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="CHÚ GIẢI KÝ HIỆU&lt;br&gt;Đường liền nét, không mũi tên  →  Association (tác nhân dùng chức năng)&lt;br&gt;Nét đứt, mũi tên hở, nhãn «include»  →  chức năng bắt buộc được gọi lại&lt;br&gt;Nét đứt, mũi tên hở, nhãn «extend»  →  chức năng mở rộng, có điều kiện&lt;br&gt;Nét liền, mũi tên tam giác rỗng  →  Generalization (kế thừa vai trò)" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fontSize=11;fillColor=#FFFDF2;strokeColor=#B9A24A;fontColor=#4A3B08;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1160" width="700" height="110" as="geometry" />
        </mxCell>
